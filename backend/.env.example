# ============================================================
# ArbitrageX 环境配置示例
# 复制此文件为 .env 并填写实际值
# ============================================================

# 数据库
DATABASE_URL=sqlite+aiosqlite:///./arbitragex.db

# JWT 密钥（生产环境请使用强随机字符串）
SECRET_KEY=your-secret-key-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# 微信登录（微信开放平台）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=http://localhost:8000/api/auth/wechat/callback

# Polymarket API（公开接口无需 Key，保留配置供未来扩展）
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com

# Binance API（公开接口无需 Key，保留配置供未来扩展）
BINANCE_API_KEY=
BINANCE_API_SECRET=

# OKX API（公开接口无需 Key，保留配置供未来扩展）
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# Gate.io API（公开接口无需 Key，保留配置供未来扩展）
GATEIO_API_KEY=
GATEIO_API_SECRET=

# Telegram 通知
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 数据刷新间隔（秒）
FUNDING_RATE_REFRESH_INTERVAL=60
PREDICTION_MARKET_REFRESH_INTERVAL=300

# 交易模式（true=模拟交易，false=实盘）
PAPER_TRADING=true

# 套利参数
MIN_ARBITRAGE_PROFIT=0.03
MAX_POSITION_SIZE=100
MAX_OPEN_POSITIONS=5
FUNDING_RATE_THRESHOLD=0.001

# 邀请分佣
REFERRAL_COMMISSION_RATE=0.10

# CORS 允许的域名（逗号分隔）
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# 服务器
HOST=0.0.0.0
PORT=8000
